#include <iostream>
using namespace std;

class CalculadoraAreas {
public:
    double calcularArea(double radio) {
        return 3.1416 * radio * radio;
    }

    double calcularArea(double base, double altura) {
        return base * altura;
    }

    double calcularArea(double base, double altura, int tipo) {
        return base * altura / 2;
    }
};
