#include <iostream>
using namespace std;

class Figura {
public:
    string color;
    int x, y;

    Figura(string c, int a, int b) {
        color = c;
        x = a;
        y = b;
    }

    virtual double calcularArea() = 0;
    virtual double calcularPerimetro() = 0;
};

class Circulo : public Figura {
public:
    double radio;

    Circulo(string c, int x, int y, double r)
        : Figura(c, x, y) {
        radio = r;
    }

    double calcularArea() override {
        return 3.1416 * radio * radio;
    }

    double calcularPerimetro() override {
        return 2 * 3.1416 * radio;
    }
};

class Rectangulo : public Figura {
public:
    double base, altura;

    Rectangulo(string c, int x, int y, double b, double h)
        : Figura(c, x, y) {
        base = b;
        altura = h;
    }

    double calcularArea() override {
        return base * altura;
    }

    double calcularPerimetro() override {
        return 2 * (base + altura);
    }
};

class Triangulo : public Figura {
public:
    double base, altura, lado1, lado2, lado3;

    Triangulo(string c, int x, int y,
              double b, double h, double l1,
              double l2, double l3)
        : Figura(c, x, y) {
        base = b;
        altura = h;
        lado1 = l1;
        lado2 = l2;
        lado3 = l3;
    }

    double calcularArea() override {
        return base * altura / 2;
    }

    double calcularPerimetro() override {
        return lado1 + lado2 + lado3;
    }
};
