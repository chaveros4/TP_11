#include <iostream>
using namespace std;

class Animal {
public:
    virtual void hacerRuido() {
        cout << "Sonido de animal" << endl;
    }

    virtual void comer() {
        cout << "El animal esta comiendo" << endl;
    }
};

class Perro : public Animal {
public:
    void hacerRuido() override {
        cout << "Guau" << endl;
    }

    void comer() override {
        cout << "El perro come alimento" << endl;
    }
};

class Gato : public Animal {
public:
    void hacerRuido() override {
        cout << "Miau" << endl;
    }

    void comer() override {
        cout << "El gato come" << endl;
    }
};

class Pajaro : public Animal {
public:
    void hacerRuido() override {
        cout << "Pio pio" << endl;
    }

    void comer() override {
        cout << "El pajaro come semillas" << endl;
    }
};
